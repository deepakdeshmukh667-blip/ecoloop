# ─────────────────────────────────────────────────────────────
# EcoLoop — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any file with real secrets.
# ─────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── AI Vision Provider ───────────────────────────────────────
# Set to "demo" for deterministic mock responses (no API key needed)
# Set to "gemini" to use Google Gemini Vision (requires GEMINI_API_KEY)
AI_PROVIDER=demo

# ── Gemini Vision (optional — only needed if AI_PROVIDER=gemini) ──
# Found in: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
